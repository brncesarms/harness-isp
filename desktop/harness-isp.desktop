[Desktop Entry]
Type=Application
Name=HarnessISP Sentinela
GenericName=HUD Sentinela para Redes e NOC
Comment=HUD Sentinela de alta disponibilidade com Anti-Lockout para Provedores de Internet
Exec=bash -c "cd $HOME/harness-isp && (test -d .venv || uv venv) && uv run python3 main.py"
Icon=network-transmit-receive
Terminal=false
Categories=Network;Development;Utility;
StartupNotify=true
Keywords=harness;isp;telecom;agy;antigravity;noc;sentinela;
